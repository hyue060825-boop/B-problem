.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/
/build/
/dist/

# 凭据；允许提交不含真实值的环境变量示例
.env
.env.*
!.env.example
*.secret
/secrets/
/credentials/

# 本地工具、工作目录与系统临时文件
